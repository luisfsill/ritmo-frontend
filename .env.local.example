# Ritmo Agendamento - Configuração de Ambiente
# ==============================================
# Copie este arquivo para .env.local e preencha com suas configurações

# API Backend
# ===========
# URL do seu backend Ritmo (OBRIGATÓRIO)
NEXT_PUBLIC_RITMO_API_URL=http://localhost:8000

# WhatsApp Integration (UAZAPI)
# ============================
# URL base da API UAZAPI
NEXT_PUBLIC_UAZAPI_URL=https://free.uazapi.com

# Token de admin da UAZAPI (necessário para criar instâncias)
# Encontre em: https://lfsystem.uazapi.com
UAZAPI_ADMIN_TOKEN=seu_token_admin_aqui

# URL do webhook para receber eventos do WhatsApp
# Configure com a URL do seu backend/n8n que receberá eventos
# Exemplo: https://seu-backend.com/webhook/chatbot
NEXT_PUBLIC_UAZAPI_WEBHOOK_URL=https://seu-webhook-aqui.com/webhook/chatbot
# Chave para armazenar token do WhatsApp no localStorage (OPCIONAL)
# Default: 'whatsapp_instance_token'
# Útil para diferenciar tokens em múltiplos ambientes (dev, staging, prod)
# NEXT_PUBLIC_TOKEN_KEY=whatsapp_instance_token_dev

# Google Analytics (OPCIONAL)
# Copie seu ID do Google Analytics se quiser rastrear eventos
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX