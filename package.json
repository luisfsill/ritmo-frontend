{
  "name": "ritmo-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0 -p 3000",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node -e \"const fs=require('fs');for(const p of ['.next/types','.next/dev/types']){fs.rmSync(p,{recursive:true,force:true})}\" && next typegen && tsc --noEmit --incremental false",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^3.9.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "swr": "^2.2.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5"
  }
}
